# Manager login (checked in-memory; no DB lookup)
MANAGER_USER=admin
MANAGER_PASSWORD=changeme
SESSION_SECRET=replace-with-a-long-random-string

# Postgres — used by both the db and app services in docker-compose.
POSTGRES_USER=quiniela
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=quiniela
# Connection URL the app uses. Host is "db" inside the compose network.
DATABASE_URL=postgres://quiniela:replace-with-a-strong-password@db:5432/quiniela
